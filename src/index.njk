---
layout: layouts/base.njk
title: Home
permalink: /
bodyClass: page-home
---
{%- set t = translations[locale or 'en'] -%}
{%- from "partials/scene-macro.njk" import renderScene -%}

<!-- Scene SVG sprite (one-time include for all elements) -->
{% include "partials/scene-sprite.njk" %}

<!-- ════════ HERO ════════ -->
<section class="hero" data-step="0">
  <div class="hero-inner">
    <figure class="hero-photo">
      <img src="{{ site.author.photo }}" alt="{{ site.author.name }}" loading="eager">
    </figure>
    <div class="hero-content">
      <p class="hero-eyebrow">— {{ t.heroEyebrow }} —</p>
      <h1 class="hero-title">
        {{ t.heroIntroLabel }}<br>
        <em>{{ site.author.nickname }}</em>.
      </h1>
      <p class="hero-sub">
        I'm <strong>{{ site.author.name }}</strong> — a social media marketer from Vietnam who keeps falling in love with new cultures, foods, and quiet street corners. This is where I write it all down.
      </p>
      <a href="#featured" class="hero-cta">Start the journey ↓</a>
    </div>
  </div>
  <div class="hero-arrow">scroll</div>
</section>

<!-- ════════ FEATURED ════════ -->
{%- set featured = collections.featuredPosts -%}

{% if featured.length %}
{%- for post in featured -%}
{%- set scene = post.data.scene or {} -%}
{%- set sceneType = scene.type or "skyscape" -%}
{%- set fallbackPresets = ["clear_day", "sunset", "twilight"] -%}
{%- set scenePreset = scene.preset or fallbackPresets[loop.index0 % 3] -%}

<section
  class="scene scene-featured"
  data-step="{{ loop.index }}"
  data-type="{{ sceneType }}"
  data-preset="{{ scenePreset }}"
>

  {{ renderScene(post, loop.index0) }}

  <!-- Meta strip -->
  <div class="scene-meta">
    <span>N° 0{{ loop.index }} · {{ post.data.country }}</span>
    {% if post.data.coords %}<span>{{ post.data.coords }}</span>{% endif %}
  </div>

  <!-- Info card -->
  <div class="scene-info">
    <span class="num">— Featured Journey —</span>
    <h3 class="lede">{{ post.data.title }}</h3>
    {% if post.data.excerpt %}
      <p class="body">{{ post.data.excerpt }}</p>
    {% endif %}
    <a href="{{ post.url }}" class="scene-cta">{{ t.readMore }} →</a>
  </div>

</section>
{%- endfor -%}
{% else %}
<section class="scene scene-empty">
  <div class="empty-state">
    <h2>No featured journeys yet.</h2>
    <p>Mark a blog post as <code>featured: true</code> to see it here.</p>
  </div>
</section>
{% endif %}

<!-- ════════ SOCIAL ════════ -->
<section class="social-section" id="featured">
  <div class="social-inner">
    <p class="section-eyebrow">— {{ t.socialEyebrow }} —</p>
    <h2 class="section-heading">{{ t.socialHeading }}</h2>
    <p class="section-sub">Day-by-day adventures live here. Long stories live above.</p>

    <ul class="social-cards">
      <li>
        <a href="{{ site.social.instagram.url }}" target="_blank" rel="noopener" class="social-card social-instagram">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
          <div class="social-card-text">
            <span class="social-platform">Instagram</span>
            <span class="social-handle">{{ site.social.instagram.handle }}</span>
          </div>
          <span class="social-arrow">→</span>
        </a>
      </li>
      <li>
        <a href="{{ site.social.youtube.url }}" target="_blank" rel="noopener" class="social-card social-youtube">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="5" width="20" height="14" rx="3"/><polygon points="10,9 16,12 10,15" fill="currentColor"/></svg>
          <div class="social-card-text">
            <span class="social-platform">YouTube</span>
            <span class="social-handle">{{ site.social.youtube.handle }}</span>
          </div>
          <span class="social-arrow">→</span>
        </a>
      </li>
      <li>
        <a href="{{ site.social.tiktok.url }}" target="_blank" rel="noopener" class="social-card social-tiktok">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M9 3v12.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M9 3c0 3 2 5 6 5"/></svg>
          <div class="social-card-text">
            <span class="social-platform">TikTok</span>
            <span class="social-handle">{{ site.social.tiktok.handle }}</span>
          </div>
          <span class="social-arrow">→</span>
        </a>
      </li>
    </ul>

    <div class="social-cta">
      <a href="/blogs/" class="btn btn-ghost">{{ t.featuredCTA }} →</a>
    </div>
  </div>
</section>

{% block extraCss %}
<link rel="stylesheet" href="/assets/css/scene-composer.css">
{% endblock %}

{% block extraJs %}
<script type="module" src="/assets/js/parallax.js"></script>
{% endblock %}

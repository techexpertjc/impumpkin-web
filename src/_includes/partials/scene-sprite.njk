    <g fill="currentColor" opacity="0.35">
      {%- for b in backB -%}
      <rect x="{{ b[0] }}" y="{{ b[2] }}" width="{{ b[1] }}" height="{{ 370 - b[2] }}"/>
      {%- endfor -%}
      {# Spires & antennae #}

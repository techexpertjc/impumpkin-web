      {# Spires on select mid buildings #}
      <rect x="192" y="100" width="4" height="15"/>
      <polygon points="542,88 528,105 556,105"/>
      <rect x="1212" y="84" width="4" height="16"/>
    </g>
    <g fill="#ffffff" opacity="0.18">
      {%- for b in midB -%}
        {%- set wStep = b[1] / (b[3] + 1) -%}
        {%- for r in range(0, 26) -%}
          {%- set wy = b[2] + 7 + r * 10 -%}
          {%- if wy < 365 -%}
            {%- for c in range(0, b[3]) -%}
              {%- if (r * 4 + c + 1) % 5 != 0 -%}
              <rect x="{{ b[0] + (c + 1) * wStep - 2 }}" y="{{ wy }}" width="4" height="5"/>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </g>

    {# ═══ FRONT ROW (darkest, most detailed — 7 buildings) ═══ #}
    {%- set frontB = [
      [180, 120, 200, 5],
      [340, 140, 110, 6],
      [530, 100, 220, 4],
      [680, 160, 85,  6],
      [890, 130, 190, 5],
      [1060, 150, 100, 6],
      [1260, 110, 210, 4]
    ] -%}

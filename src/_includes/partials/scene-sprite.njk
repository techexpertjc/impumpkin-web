    {# ═══ BACK ROW (lightest — tallest peaks poking above) ═══ #}
    {%- set backB = [
      [80, 48, 50, 3],
      [260, 52, 60, 3],
      [460, 44, 40, 3],
      [660, 50, 55, 3],
      [850, 46, 45, 3],
      [1040, 52, 58, 3],
      [1240, 44, 50, 3],
      [1430, 50, 55, 3]

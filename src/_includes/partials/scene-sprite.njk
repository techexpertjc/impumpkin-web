      {%- for b in frontB -%}
      <rect x="{{ b[0] }}" y="{{ b[2] }}" width="{{ b[1] }}" height="{{ 370 - b[2] }}"/>
      {%- endfor -%}
      {# Spires and antennae on tall buildings #}
      <polygon points="410,92 396,110 424,110"/>
      <rect x="758" y="67" width="4" height="18"/>
      <polygon points="1135,82 1118,100 1152,100"/>
    </g>
    <g fill="#ffffff" opacity="0.3">
      {%- for b in frontB -%}
        {%- set wStep = b[1] / (b[3] + 1) -%}
        {%- for r in range(0, 30) -%}
          {%- set wy = b[2] + 8 + r * 10 -%}
          {%- if wy < 363 -%}
            {%- for c in range(0, b[3]) -%}
              {%- if (r * b[3] + c + 2) % 6 != 0 -%}
              <rect x="{{ b[0] + (c + 1) * wStep - 2.5 }}" y="{{ wy }}" width="5" height="5"/>

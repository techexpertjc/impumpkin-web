    <g fill="#ffffff" opacity="0.1">
      {%- for b in backB -%}
        {%- set wStep = b[1] / (b[3] + 1) -%}
        {%- for r in range(0, 32) -%}
          {%- set wy = b[2] + 8 + r * 10 -%}
          {%- if wy < 365 -%}
            {%- for c in range(0, b[3]) -%}
              {%- if (r * 3 + c) % 4 != 0 -%}
              <rect x="{{ b[0] + (c + 1) * wStep - 2 }}" y="{{ wy }}" width="4" height="4"/>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </g>

    {# ═══ MIDDLE ROW ═══ #}
    {%- set midB = [
      [20, 62, 150, 4],
      [160, 68, 115, 4],
      [340, 58, 140, 4],
      [510, 64, 105, 4],
      [690, 58, 130, 4],
      [860, 66, 110, 4],
      [1030, 60, 135, 4],
      [1180, 68, 100, 4],
      [1340, 58, 125, 4],
      [1490, 64, 140, 4]
    ] -%}

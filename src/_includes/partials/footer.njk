{%- set t = translations[locale or 'en'] -%}
<footer class="site-footer">
  <div class="site-footer-inner">

    <div class="footer-brand">
      <p class="footer-mark">{{ site.title }}</p>
      <p class="footer-tagline">{{ site.tagline }}</p>
    </div>

    <div class="footer-newsletter">
      <h3 class="footer-heading">{{ t.newsletterHeading }}</h3>
      <form id="newsletter-form" class="newsletter-form" novalidate>
        <input
          type="email"
          name="email"
          required
          placeholder="{{ t.newsletterPlaceholder }}"
          aria-label="{{ t.newsletterPlaceholder }}"
        >
        <button type="submit">{{ t.newsletterButton }}</button>
      </form>
      <p class="form-status" data-newsletter-status></p>
    </div>

    <div class="footer-social">
      <h3 class="footer-heading">{{ t.socialEyebrow }}</h3>
      <ul class="social-list">
        <li>
          <a href="{{ settings.instagram.url or site.social.instagram.url }}" target="_blank" rel="noopener" aria-label="Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/></svg>
            <span>{{ settings.instagram.handle or site.social.instagram.handle }}</span>
          </a>
        </li>
        <li>
          <a href="{{ settings.youtube.url or site.social.youtube.url }}" target="_blank" rel="noopener" aria-label="YouTube">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="5" width="20" height="14" rx="3"/><polygon points="10,9 16,12 10,15" fill="currentColor"/></svg>
            <span>{{ settings.youtube.handle or site.social.youtube.handle }}</span>
          </a>
        </li>
        <li>
          <a href="{{ settings.tiktok.url or site.social.tiktok.url }}" target="_blank" rel="noopener" aria-label="TikTok">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 3v12.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M9 3c0 3 2 5 6 5"/></svg>
            <span>{{ settings.tiktok.handle or site.social.tiktok.handle }}</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© {% currentYear %} {{ site.author.name }}. {{ t.rightsReserved }}</p>
    <p>{{ t.footerTagline }}</p>
  </div>
</footer>
